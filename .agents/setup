#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

echo "==> Checking system dependencies"
packages=()
if ! command -v ffmpeg >/dev/null || ! command -v ffprobe >/dev/null; then
  packages+=(ffmpeg)
fi
if ! command -v rsync >/dev/null; then
  packages+=(rsync)
fi
# Browser tests default to this system executable, not Playwright's browser cache.
if [[ ! -x /usr/bin/chromium ]]; then
  packages+=(chromium)
fi
if ((${#packages[@]})); then
  sudo apt-get update
  sudo apt-get install -y "${packages[@]}"
fi

if ! command -v uv >/dev/null; then
  echo "uv is required but is not installed in this orb" >&2
  exit 1
fi
node_version=$(cat .node-version)
node_home="$HOME/.local/share/cameradeck/node-$node_version"
if [[ ! -x "$node_home/bin/node" ]]; then
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo "Unsupported Node architecture" >&2; exit 1 ;;
  esac
  download=$(mktemp -d)
  trap 'rm -rf "$download"' EXIT
  archive="node-v$node_version-linux-$arch.tar.xz"
  curl -fsSL "https://nodejs.org/dist/v$node_version/$archive" -o "$download/$archive"
  curl -fsSL "https://nodejs.org/dist/v$node_version/SHASUMS256.txt" -o "$download/SHASUMS256.txt"
  (cd "$download" && grep "  $archive$" SHASUMS256.txt | sha256sum -c -)
  mkdir -p "$node_home"
  tar -xJf "$download/$archive" --strip-components=1 -C "$node_home"
fi
export PATH="$node_home/bin:$PATH"

echo "==> Installing locked Python dependencies"
# Preserve the orb-only JPEG encoder across warm setup runs.
time uv sync --frozen --inexact

echo "==> Installing the synthetic capture JPEG encoder"
# On the Pi this comes from python3-picamera2; the x86 orb needs a wheel.
time uv pip install --python .venv/bin/python simplejpeg==1.9.0

echo "==> Installing and building the frontend"
time python3 scripts/frontend.py build

bash .agents/resume

echo "==> CameraDeck orb setup complete"
